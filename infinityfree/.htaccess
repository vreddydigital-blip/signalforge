# SignalForge — InfinityFree (Apache) configuration
Options -Indexes
DirectoryIndex index.html

# Never serve the database credentials file, even if PHP is misconfigured.
<Files "config.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>

# The example config is a template, not a secret, but it has no business being
# served either.
<Files "sf-config.example.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>

# Block dotfiles (.env, .git, .htaccess itself is still read by Apache).
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # The tracker is embedded on other sites, so it must stay fetchable cross-origin.
  <FilesMatch "tracker\.js$">
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Images and fonts are content-stable, so they can be cached for a year.
  <FilesMatch "\.(woff2?|png|jpe?g|gif|svg|webp|ico)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
  # The dashboard's own JS/CSS are NOT fingerprinted (no build step), so a
  # year-long cache would pin users to a stale bundle after a deploy. Keep
  # these short and let the browser revalidate.
  <FilesMatch "\.(js|css)$">
    ExpiresDefault "access plus 1 hour"
  </FilesMatch>
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Single-page app: unknown paths fall back to index.html so client routing works.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS (InfinityFree issues a free certificate; harmless if not yet active).
  #
  # The health endpoint is exempt. Container platforms (Railway, Render, Fly)
  # probe it from inside the container over plain HTTP, with no
  # X-Forwarded-Proto header, so a redirect here makes the probe see 301
  # instead of 200 and the deploy is marked unhealthy even though the app is
  # fine. The endpoint returns no secrets, so serving it over HTTP internally
  # is safe; external traffic still gets redirected.
  RewriteCond %{REQUEST_URI} !^/api/health\.php$
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Real files and directories (assets, api/*.php, tracker.js) are served as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>
