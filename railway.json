{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infinityfree/Dockerfile",
    "watchPatterns": [
      "infinityfree/**"
    ]
  },
  "deploy": {
    "startCommand": null,
    "healthcheckPath": "/api/health.php",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "numReplicas": 1
  }
}
