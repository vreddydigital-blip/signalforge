# ---- Orchestration service (Render) ----
# Copy to .env for local runs. NEVER commit a real .env.

# Required: your Groq API key from https://console.groq.com/keys
GROQ_API_KEY=
# Any Groq chat model. llama-3.3-70b-versatile is a good default.
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.2
GROQ_TIMEOUT_SECONDS=30

# auto   = use Groq when GROQ_API_KEY is set, otherwise deterministic narrative
# heuristic = never call the network (useful for tests and offline demos)
SIGNALFORGE_LLM_MODE=auto

# Shared secret the PHP backend sends as `Authorization: Bearer <token>`.
# Leave empty to disable auth (local development only).
# Generate with: openssl rand -hex 32
SIGNALFORGE_API_TOKEN=

SIGNALFORGE_MAX_ATTEMPTS=3
SIGNALFORGE_RUN_TTL_SECONDS=3600
SIGNALFORGE_MAX_RUNS=200
SIGNALFORGE_CORS_ORIGINS=*
LOG_LEVEL=INFO
PORT=8000
